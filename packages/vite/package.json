{
  "name": "@specrig/vite",
  "version": "0.2.0",
  "description": "specrig for an app built with Vite: the plugin that serves its runtime settings, the checks that every setting it reads is answered, and init.",
  "keywords": [
    "vite",
    "vite-plugin",
    "playwright",
    "bdd",
    "runtime-config",
    "spec-first"
  ],
  "homepage": "https://github.com/specrig/specrig-js#readme",
  "bugs": {
    "url": "https://github.com/specrig/specrig-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specrig/specrig-js.git",
    "directory": "packages/vite"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "bin": {
    "specrig": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "playwright test && (cd test/app && node ../../dist/cli.js surface) && bddgen -c test/app/playwright.config.ts && playwright test -c test/app/playwright.config.ts"
  },
  "dependencies": {
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@specrig/web": "^0.2.0",
    "@playwright/test": ">=1.50.0",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@specrig/web": "^0.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.12.2",
    "playwright-bdd": "^9.2.1",
    "vite": "^8.0.10"
  }
}

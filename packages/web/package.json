{
  "name": "@specrig/web",
  "version": "0.3.0",
  "description": "A Playwright harness for a web app developed specification first: backends stood in for by their contract, and records of what the app can request and what its cases make it send.",
  "keywords": [
    "playwright",
    "playwright-bdd",
    "bdd",
    "openapi",
    "contract-testing",
    "spec-first",
    "ai-agents"
  ],
  "homepage": "https://github.com/specrig/specrig-js#readme",
  "bugs": {
    "url": "https://github.com/specrig/specrig-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specrig/specrig-js.git",
    "directory": "packages/web"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "default": "./dist/init.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "playwright test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^6.0.2",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0",
    "playwright-bdd": ">=8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.12.2",
    "playwright-bdd": "^9.2.1"
  }
}

{
  "name": "@specrig/vite",
  "version": "0.1.0",
  "description": "specrig for an app built with Vite: the plugin that serves its runtime settings, the checks that every setting it reads is answered, and init.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "bin": {
    "specrig": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "playwright test && bddgen -c test/app/playwright.config.ts && playwright test -c test/app/playwright.config.ts"
  },
  "peerDependencies": {
    "@specrig/web": "^0.1.0",
    "@playwright/test": ">=1.50.0",
    "typescript": ">=5.0.0",
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@specrig/web": "^0.1.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.12.2",
    "playwright-bdd": "^9.2.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  }
}
